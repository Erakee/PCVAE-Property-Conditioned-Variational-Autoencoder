*.swo

# OS
.DS_Store
Thumbs.db

# 生成物：SMILES / 焓值 / summary 等（generate_dhr.py 等脚本输出）
generate_smi/

# 由 util.utils 从 em_train.smi 自动构建，可删除后重新生成
.tokenizer.pkl

# 训练日志默认目录（CVAE_DHR.TrainingLogger 未指定 base_dir 时）
experiments/

# config.yaml 中的采样目录（若存在）
sampled/
target_sample/

# 工具脚本产生的大量 xyz / 中间输出（保留源码即可）
other_tool/smiles2xyz/outputxyz/
other_tool/smiles2xyz/batch*/
other_tool/smiles2xyz/*.xyz

# Jupyter
.ipynb_checkpoints/

# pcvae_tool 自带的运行产物（权重/缓存/输出）
pcvae_tool/outputs/
pcvae_tool/data/.tokenizer.pkl

# ── 本地私有 / 运行产物（公开仓库建议不提交）────────────────
# 仅本机使用的脚本、笔记、密钥等（与 local.example/ 可选模板分离）
local/

# 训练 checkpoint、日志、Excel、sweep 汇总（见 config.yaml training_runs_root）
training_params/

# 生成脚本输出根目录（见 config.yaml generation_output_root）
generations/

# 根目录 parameters/ 下默认 encoder.pt / decoder.pt（多为本机权重）
parameters/*.pt

# 数据集缓存、指纹等（CSV 是否忽略请按项目需要自行调整）
data/*.pkl
data/*_soap_*.pkl

# 训练过程 Excel、临时表格
*.xlsx

# 环境变量与密钥（若使用）
.env
.env.*

# Debug 产物
debug/*.pt
debug/*.pth

# 常见实验跟踪目录
wandb/
lightning_logs/
runs/
